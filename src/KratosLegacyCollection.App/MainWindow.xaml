<Window x:Class="KratosLegacyCollection.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:KratosLegacyCollection.App" Title="Kratos Legacy Collection" Width="1280" Height="860" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True" Drop="OnDrop">
 <Window.Resources>
  <DataTemplate x:Key="EmulatorEditor">
   <Border Background="#202020" BorderBrush="#514738" BorderThickness="0,1,0,0" Padding="18" Margin="0,0,0,16">
    <StackPanel>
     <DockPanel><TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="24" DockPanel.Dock="Left"/><TextBlock Text="{Binding Platform}" HorizontalAlignment="Right" Foreground="{StaticResource Bronze}" VerticalAlignment="Center"/></DockPanel>
     <TextBlock Text="{Binding Version}" Foreground="{StaticResource Muted}" Margin="0,6"/>
     <TextBlock Text="EXECUTABLE" Style="{StaticResource Label}"/>
     <TextBox Text="{Binding Executable, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" AutomationProperties.Name="Emulator executable"/>
     <WrapPanel>
      <Button Content="SELECT EXECUTABLE" Command="{Binding DataContext.BrowseEmulator, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
      <Button Content="DOWNLOAD FROM OFFICIAL WEBSITE" Command="{Binding DataContext.DownloadEmulator, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
     </WrapPanel>
     <TextBlock Text="DATA FOLDER" Style="{StaticResource Label}"/>
     <TextBox Text="{Binding DataDirectory}" IsReadOnly="True" AutomationProperties.Name="Emulator data folder"/>
     <WrapPanel>
      <Button Content="SELECT DATA FOLDER" Command="{Binding DataContext.BrowseData, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
      <Button Content="OPEN EMULATOR" Command="{Binding DataContext.OpenEmulator, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
      <Button Content="OFFICIAL SETUP GUIDE" Command="{Binding DataContext.OpenGuide, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
      <Button Content="CREATE PORTABLE COPY" Command="{Binding DataContext.CreatePortable, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
     </WrapPanel>
     <TextBlock Text="{Binding Guidance}" Foreground="{StaticResource Muted}" Margin="0,12,0,4" LineHeight="22"/>
     <CheckBox Content="I have completed this emulator's setup and verified its data folder." IsChecked="{Binding Prepared}"/>
    </StackPanel>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0D0D0D" BorderBrush="#7E6445" BorderThickness="0,0,0,1" Padding="26,15">
   <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="KRATOS" FontFamily="Georgia" FontSize="27"/><TextBlock Text="LEGACY COLLECTION" Foreground="{StaticResource Bronze}" FontSize="11"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="GREEK SAGA" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/><TextBlock Text="{Binding CollectionSummary}" FontSize="11" Foreground="{StaticResource Bronze}" HorizontalAlignment="Right"/></StackPanel></DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#191817" BorderBrush="#3F372D" BorderThickness="0,0,1,0" Padding="14,26,10,20">
    <DockPanel>
     <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="INDEPENDENT FAN PROJECT" FontSize="10" Foreground="{StaticResource Muted}" Margin="10,18"/><TextBlock Text="Forged for your own collection." FontFamily="Georgia" Foreground="{StaticResource Bronze}" Margin="10,0,10,8"/></StackPanel>
     <StackPanel>
      <TextBlock Text="THE COLLECTION" Style="{StaticResource Label}" Margin="10,0,0,18"/>
      <Button x:Name="LibraryNav" Content="GAME LIBRARY" Command="{Binding Navigate}" CommandParameter="GAME LIBRARY" HorizontalContentAlignment="Left"/>
      <Button x:Name="EnhancementsNav" Content="ENHANCEMENTS" Command="{Binding Navigate}" CommandParameter="ENHANCEMENTS"/>
      <Button x:Name="EmulatorsNav" Content="EMULATOR SETUP" Command="{Binding Navigate}" CommandParameter="EMULATOR SETUP"/>
      <Button x:Name="SettingsNav" Content="SETTINGS" Command="{Binding Navigate}" CommandParameter="SETTINGS"/>
      <Button x:Name="AboutNav" Content="ABOUT" Command="{Binding Navigate}" CommandParameter="ABOUT"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,24,22,24">
    <StackPanel>
     <StackPanel Visibility="{Binding IsLibrary, Converter={StaticResource Bool}}">
      <DockPanel Margin="0,0,0,8"><TextBlock Text="GREEK SAGA" Style="{StaticResource Heading}"/><TextBlock Text="SIX CHAPTERS. ONE LEGACY." HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Bronze}"/></DockPanel>
      <TextBlock Text="Begin with the games you own. Every chapter stands on its own." Foreground="{StaticResource Muted}" Margin="0,0,0,18"/>
      <ListBox x:Name="GameCards" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Greek saga game library">
       <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemTemplate><DataTemplate>
        <Border Width="270" BorderBrush="#69543B" BorderThickness="1" Background="#22201D">
         <StackPanel>
          <Grid Height="126" ClipToBounds="True"><local:GreekArtwork Chapter="{Binding Chapter}"/><TextBlock Text="{Binding Chapter}" FontFamily="Georgia" FontSize="39" Foreground="#D1B17C" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"/></Grid>
          <StackPanel Margin="15,12,15,14">
           <TextBlock Text="{Binding Platform}" Foreground="{StaticResource Bronze}" FontSize="10"/>
           <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="19" Height="52" Margin="0,6,0,4"/>
           <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6"/>
           <Button Content="{Binding PrimaryAction}" Style="{StaticResource Primary}" Command="{Binding DataContext.CardAction, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0"/>
          </StackPanel>
         </StackPanel>
        </Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Border x:Name="GameDetails" BorderBrush="#7E6445" BorderThickness="0,2,0,0" Padding="0,22,0,0" Margin="0,14,0,0">
       <StackPanel>
        <TextBlock Text="SELECTED CHAPTER" Style="{StaticResource Label}"/>
        <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource Heading}"/>
        <TextBlock Text="{Binding Selected.Subtitle}" FontFamily="Georgia" Foreground="{StaticResource Bronze}" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding Selected.Status}" FontWeight="SemiBold"/>
        <WrapPanel><Button Content="PLAY" Style="{StaticResource Primary}" Command="{Binding Play}"/><Button Content="ADD GAME FILES" Command="{Binding BrowseGame}"/><Button Content="SELECT PS3 FOLDER" Command="{Binding BrowseGameFolder}"/><Button Content="SEARCH FOR GAMES" Command="{Binding SearchGames}"/><Button Content="ENHANCEMENTS" Command="{Binding Navigate}" CommandParameter="ENHANCEMENTS"/></WrapPanel>
        <TextBlock Text="GAME LOCATION" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.Path, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Game location"/>
        <WrapPanel>
         <StackPanel Width="190"><TextBlock Text="GAME ID" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.GameId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Game ID"/></StackPanel>
         <StackPanel Width="130"><TextBlock Text="REVISION" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.Revision, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Game revision"/></StackPanel>
         <StackPanel Width="160"><TextBlock Text="ELF CRC (PS2)" Style="{StaticResource Label}"/><TextBox Text="{Binding Selected.Crc, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="ELF CRC"/></StackPanel>
         <StackPanel Width="160"><TextBlock Text="REGION" Style="{StaticResource Label}"/><TextBlock Text="{Binding Selected.Region}" Margin="0,12"/></StackPanel>
        </WrapPanel>
        <TextBlock Text="For compressed images, copy the exact Game ID from the emulator and validate it. An ELF CRC is reported by PCSX2; it is not an ISO checksum." Foreground="{StaticResource Muted}"/>
        <WrapPanel><Button Content="VALIDATE FILES" Command="{Binding ValidateGame}"/><Button Content="COPY TO PORTABLE FOLDER" Command="{Binding CopyGame}"/></WrapPanel>
        <TextBlock Text="SEARCH RESULTS" Style="{StaticResource Label}"/>
        <ListBox ItemsSource="{Binding Discovered}" SelectedItem="{Binding SelectedDiscovery}" MinHeight="42" MaxHeight="170" AutomationProperties.Name="Detected games"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <Button Content="ASSOCIATE SELECTED RESULT" Command="{Binding AssociateGame}" HorizontalAlignment="Left"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <StackPanel Visibility="{Binding IsEnhancements, Converter={StaticResource Bool}}">
      <TextBlock Text="ENHANCEMENTS" Style="{StaticResource Heading}"/>
      <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" AutomationProperties.Name="Enhancement game"/>
      <TextBlock Text="HD TEXTURE PACKS" Style="{StaticResource Label}"/>
      <TextBlock Text="Import your own authorized packs. The archive must match this game's exact ID. ZIP is supported. For 7Z, use a trusted extractor and repackage only the textures as ZIP." Foreground="{StaticResource Muted}"/>
      <TextBlock Text="AUTHOR CREDIT" Style="{StaticResource Label}"/><TextBox Text="{Binding ModAuthor}" AutomationProperties.Name="Texture pack author"/>
      <WrapPanel><Button Content="IMPORT TEXTURE PACK" Command="{Binding ImportTextures}" Style="{StaticResource Primary}"/><Button Content="VIEW CREATOR'S CHANNEL" Command="{Binding OpenCreatorPage}"/><Button Content="OPEN CREATOR'S DISCORD" Command="{Binding OpenCreator}"/></WrapPanel>
      <TextBlock Text="Modder Espartano: credited creator. Packs, archive versions, distribution rights and Discord invitations must be checked at the original publication. No third-party pack is bundled. Drop a compatible ZIP anywhere in this window to import it." Foreground="{StaticResource Muted}" Margin="0,10"/>
      <TextBlock Text="PERFORMANCE PATCHES" Style="{StaticResource Label}"/>
      <TextBlock Text="60 FPS: NOT AVAILABLE until you import a compatible, authorized patch. Some games already run at 60 FPS. No generic speed or frame-rate code is supplied. Select the imported performance patch below to enable or disable it."/>
      <Button Content="IMPORT 60 FPS / PERFORMANCE PATCH" Command="{Binding ImportPerformance}" HorizontalAlignment="Left"/>
      <TextBlock Text="DISPLAY PATCHES" Style="{StaticResource Label}"/>
      <TextBlock Text="Native widescreen and a wider field of view depend on the game. A 16:9 aspect setting alone can stretch the image. Use the game's display option or verified emulator patch. RPCS3 patches use Manage > Game Patches in RPCS3." Foreground="{StaticResource Muted}"/>
      <WrapPanel><Button Content="IMPORT DISPLAY PATCH" Command="{Binding ImportDisplay}"/><Button Content="OPEN EMULATOR" Command="{Binding OpenEmulator}"/><Button Content="OFFICIAL SETUP GUIDE" Command="{Binding OpenGuide}"/></WrapPanel>
      <TextBlock Text="GRAPHICS SETTINGS" Style="{StaticResource Label}"/>
      <WrapPanel><StackPanel Width="200"><TextBlock Text="PRESET"/><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Selected.Preset}" AutomationProperties.Name="Graphics preset"/></StackPanel><StackPanel Width="160"><TextBlock Text="SCALE (1 TO 10)"/><TextBox Text="{Binding Selected.Resolution}" AutomationProperties.Name="Resolution scale"/></StackPanel><StackPanel Width="200"><TextBlock Text="PSP RENDERER"/><ComboBox ItemsSource="{Binding Renderers}" SelectedItem="{Binding Selected.Renderer}" AutomationProperties.Name="PSP renderer"/></StackPanel></WrapPanel>
      <CheckBox Content="Use 16:9 output aspect (PCSX2). Enable native widescreen inside the game separately." IsChecked="{Binding Selected.Widescreen}"/>
      <TextBlock Text="Original: 1x. Enhanced: 3x. Ultra HD: 6x; requires suitable hardware. PCSX2 2.6+ and PPSSPP use private launch profiles. RPCS3 graphics are configured in its native per-game settings; the selection here is a saved preference." Foreground="{StaticResource Muted}"/>
      <Button Content="SAVE GAME SETTINGS" Command="{Binding SaveSettings}" HorizontalAlignment="Left"/>
      <TextBlock Text="INSTALLED ENHANCEMENTS" Style="{StaticResource Label}"/>
      <TextBlock Text="No entries means no enhancements have been imported for this chapter." Foreground="{StaticResource Muted}" FontSize="12"/>
      <ListBox ItemsSource="{Binding Installed}" SelectedItem="{Binding SelectedMod}" MinHeight="80" MaxHeight="250" AutomationProperties.Name="Installed enhancements"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#64523D" BorderThickness="0,0,0,1" Padding="10"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><WrapPanel><TextBlock Text="{Binding Kind}" Margin="0,0,14,0"/><TextBlock Text="{Binding Author}" Margin="0,0,14,0"/><TextBlock Text="Enabled: "/><TextBlock Text="{Binding Enabled}"/></WrapPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      <WrapPanel><Button Content="ENABLE" Command="{Binding ModAction}" CommandParameter="enable"/><Button Content="DISABLE / RESTORE BACKUP" Command="{Binding ModAction}" CommandParameter="disable"/><Button Content="UNINSTALL" Command="{Binding ModAction}" CommandParameter="uninstall"/><Button Content="VIEW MOD PAGE" Command="{Binding ModAction}" CommandParameter="page"/></WrapPanel>
     </StackPanel>
     <StackPanel Visibility="{Binding IsEmulators, Converter={StaticResource Bool}}">
      <TextBlock Text="EMULATOR SETUP" Style="{StaticResource Heading}"/>
      <TextBlock Text="Set up only what you need. Existing installations and original data stay in place." Foreground="{StaticResource Muted}"/>
      <WrapPanel><Button Content="DETECT INSTALLED EMULATORS" Command="{Binding DetectEmulators}"/><Button Content="SEARCH ANOTHER FOLDER" Command="{Binding SearchEmulators}"/></WrapPanel>
      <ItemsControl ItemsSource="{Binding Emulators}" ItemTemplate="{StaticResource EmulatorEditor}"/>
      <Button Content="SAVE EMULATOR SETTINGS" Command="{Binding SaveSettings}" HorizontalAlignment="Left"/>
     </StackPanel>
     <StackPanel Visibility="{Binding IsSettings, Converter={StaticResource Bool}}">
      <TextBlock Text="SETTINGS" Style="{StaticResource Heading}"/>
      <TextBlock Text="COLLECTION STORAGE" Style="{StaticResource Label}"/><TextBlock Text="{Binding StorageRoot}" FontFamily="Consolas"/>
      <CheckBox Content="PORTABLE MODE" IsChecked="{Binding Portable}"/><TextBlock Text="{Binding StorageDescription}" Foreground="{StaticResource Muted}"/>
      <TextBlock Text="External files stay at their original paths until you explicitly copy them. Move the entire collection folder to keep its relative paths working. Do not move it while a copy or enhancement transaction is running." Margin="0,10" Foreground="{StaticResource Muted}"/>
      <CheckBox Content="Launch games in fullscreen" IsChecked="{Binding Fullscreen}"/>
      <CheckBox Content="Reduce motion and disable ambient embers" IsChecked="{Binding ReducedMotion}"/>
      <TextBlock Text="CREATOR LINKS" Style="{StaticResource Label}"/>
      <TextBlock Text="Current Discord invitation (verify it at the creator's original publication)"/><TextBox Text="{Binding CreatorDiscord}" AutomationProperties.Name="Creator Discord invitation"/>
      <TextBlock Text="Original publication where this invitation appears"/><TextBox Text="{Binding CreatorSource}" AutomationProperties.Name="Creator invitation source"/>
      <Button Content="SAVE SETTINGS" Command="{Binding SaveSettings}" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
      <TextBlock Text="BACKUP AND DIAGNOSTICS" Style="{StaticResource Label}"/>
      <TextBlock Text="Backups contain launcher settings and private paths. Store them privately. Enhancement backups are kept beside their payloads in Data/Enhancements; disabling an enhancement restores its previous files. Emulator saves require a separate backup." Foreground="{StaticResource Muted}"/>
      <WrapPanel><Button Content="BACK UP SETTINGS" Command="{Binding Backup}"/><Button Content="RESTORE SETTINGS" Command="{Binding Restore}"/><Button Content="OPEN DATA FOLDER" Command="{Binding OpenData}"/><Button Content="RUN FIRST-TIME SETUP" Command="{Binding ResumeSetup}"/></WrapPanel>
     </StackPanel>
     <StackPanel Visibility="{Binding IsAbout, Converter={StaticResource Bool}}">
      <local:GreekArtwork Height="210" Chapter="VI"/>
      <TextBlock Text="KRATOS LEGACY COLLECTION" Style="{StaticResource Heading}" Margin="0,22,0,12"/>
      <TextBlock Text="An independent, free and open-source launcher for your own Greek saga collection." FontSize="17"/>
      <TextBlock Text="Version 0.1.0 | Windows x64 | .NET 10 LTS | WPF" Foreground="{StaticResource Bronze}" Margin="0,16"/>
      <TextBlock Text="This is an unofficial fan project. It is not affiliated with, endorsed by or sponsored by Sony Interactive Entertainment or Santa Monica Studio. Game titles and emulator names belong to their respective owners. The application includes no games, BIOS, proprietary firmware, official art or third-party texture packs." LineHeight="25"/>
      <TextBlock Text="CREDITS" Style="{StaticResource Label}"/>
      <TextBlock Text="PCSX2, PPSSPP and RPCS3: independent emulator projects. Modder Espartano and other pack authors retain their own work. Original architectural vector artwork and launcher code are distributed under the repository's MIT license. System fonts are used without redistribution." Foreground="{StaticResource Muted}"/>
      <TextBlock Text="Only use game dumps and enhancements you are entitled to use. The project name has not received legal trademark clearance." Margin="0,18" Foreground="{StaticResource Muted}"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Background="#24211D" BorderBrush="#7E6445" BorderThickness="0,1,0,0" Padding="18,9">
   <DockPanel><Button Content="CANCEL" Command="{Binding Cancel}" DockPanel.Dock="Right" Visibility="{Binding Busy, Converter={StaticResource Bool}}"/><StackPanel><ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding Busy, Converter={StaticResource Bool}}" Margin="0,0,0,7"/><TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1E9DB"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="#FFB6A4"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DockPanel>
  </Border>
  <Border Grid.RowSpan="2" Background="#141414" Visibility="{Binding SetupVisible, Converter={StaticResource Bool}}" Panel.ZIndex="10">
   <Grid Margin="36,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><TextBlock Text="KRATOS LEGACY COLLECTION" Foreground="{StaticResource Bronze}"/><TextBlock Text="{Binding SetupProgress}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,28,16,20" HorizontalScrollBarVisibility="Disabled">
     <StackPanel MaxWidth="980" HorizontalAlignment="Stretch">
      <TextBlock Text="{Binding SetupTitle}" FontFamily="Georgia" FontSize="34" Margin="0,0,0,20"/>
      <StackPanel Visibility="{Binding WelcomeStep, Converter={StaticResource Bool}}">
       <local:GreekArtwork Height="210" Chapter="I"/>
       <TextBlock Text="A place for your Greek saga." FontFamily="Georgia" FontSize="25" Foreground="{StaticResource Bronze}" Margin="0,24,0,12"/>
       <TextBlock Text="Configure the emulators you need, add your own game files and manage compatible enhancements. Each chapter works independently." FontSize="17" LineHeight="27"/>
       <TextBlock Text="No games, BIOS or proprietary firmware are included. Supply your own legally obtained files. This independent fan project is not affiliated with Sony or Santa Monica Studio." Foreground="{StaticResource Muted}" Margin="0,20" LineHeight="24"/>
      </StackPanel>
      <StackPanel Visibility="{Binding EmulatorStep, Converter={StaticResource Bool}}">
       <TextBlock Text="Detect existing emulators or select an executable. Official download links open in your browser. You can skip emulators you do not need." Foreground="{StaticResource Muted}"/>
       <WrapPanel><Button Content="DETECT INSTALLED EMULATORS" Command="{Binding DetectEmulators}"/><Button Content="SEARCH ANOTHER FOLDER" Command="{Binding SearchEmulators}"/></WrapPanel>
       <ItemsControl ItemsSource="{Binding Emulators}" ItemTemplate="{StaticResource EmulatorEditor}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding ConfigurationStep, Converter={StaticResource Bool}}">
       <TextBlock Text="Use each emulator's own setup for BIOS, firmware, controls, save locations and hardware options. Existing settings are never silently overwritten. Confirm only the emulators you have actually prepared." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
       <ItemsControl ItemsSource="{Binding Emulators}" ItemTemplate="{StaticResource EmulatorEditor}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding ModeStep, Converter={StaticResource Bool}}">
       <CheckBox Content="PORTABLE MODE" IsChecked="{Binding Portable}" FontSize="20"/><TextBlock Text="{Binding StorageDescription}" FontSize="17" LineHeight="26"/>
       <TextBlock Text="Uncheck PORTABLE MODE to use existing emulators. You can switch later in Settings. Copying games or emulator data is always a separate explicit operation. No removable drive is required." Foreground="{StaticResource Muted}" Margin="0,22"/>
       <TextBlock Text="CURRENT COLLECTION FOLDER" Style="{StaticResource Label}"/><TextBlock Text="{Binding StorageRoot}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding FinishStep, Converter={StaticResource Bool}}">
       <local:GreekArtwork Height="230" Chapter="VI"/><TextBlock Text="The gates are open." FontFamily="Georgia" FontSize="28" Foreground="{StaticResource Bronze}" Margin="0,24,0,16"/>
       <TextBlock Text="Enter the library and add the games you own. An empty library is ready for configuration. You can return to Emulator Setup at any time." FontSize="17"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="8,16,8,0"><Button Content="BACK" Command="{Binding Back}" DockPanel.Dock="Left"/><TextBlock Text="Progress is saved after each step. You can close and resume later." VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0"/><Button x:Name="SetupNext" Content="{Binding NextLabel}" Command="{Binding Next}" Style="{StaticResource Primary}" DockPanel.Dock="Right" MinWidth="190" HorizontalAlignment="Right"/></DockPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
