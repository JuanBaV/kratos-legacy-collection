<Application x:Class="KratosLegacyCollection.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Stone" Color="#141414"/><SolidColorBrush x:Key="Panel" Color="#202020"/>
  <SolidColorBrush x:Key="Bone" Color="#F1E9DB"/><SolidColorBrush x:Key="Muted" Color="#BDB6AA"/>
  <SolidColorBrush x:Key="Bronze" Color="#C1A06B"/><SolidColorBrush x:Key="Blood" Color="#B53932"/>
  <BooleanToVisibilityConverter x:Key="Bool"/>
  <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Stone}"/><Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource Bone}"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="29"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Bronze}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,14,0,7"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="Background" Value="#33302B"/><Setter Property="BorderBrush" Value="#76634A"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="15,9"/><Setter Property="MinHeight" Value="44"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#574335"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#F1E9DB"/><Setter TargetName="Border" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#7B2B25"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#963029"/><Setter Property="BorderBrush" Value="#C76454"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#111111"/><Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="CaretBrush" Value="{StaticResource Bone}"/><Setter Property="BorderBrush" Value="#796A54"/><Setter Property="Padding" Value="9"/><Setter Property="MinHeight" Value="39"/><Setter Property="Margin" Value="0,3,8,7"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Bone}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="Margin" Value="0,3,8,7"/><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="#141414"/><Setter Property="Background" Value="#F1E9DB"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="Margin" Value="0,10,0,10"/><Setter Property="MinHeight" Value="30"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,8,10"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#50362B"/></Trigger></Style.Triggers></Style>
 </Application.Resources>
</Application>
